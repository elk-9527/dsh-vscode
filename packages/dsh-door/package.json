  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek harness",
    "acp",
    "agent client protocol",
    "vscode"
  ],
  "homepage": "https://github.com/elk-9527/dsh-vscode/tree/main/packages/dsh-door#readme",
  "bugs": {
    "url": "https://github.com/elk-9527/dsh-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elk-9527/dsh-vscode.git",
    "directory": "packages/dsh-door"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-acp": "0.1.5-rc.2 || 0.1.5-rc.3 || 0.2.0-rc.1 || 0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-acp": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
