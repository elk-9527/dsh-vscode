{
  "name": "dsh-panel",
  "displayName": "DSH Panel",
  "description": "在 VS Code 侧边栏中直接使用 DeepSeek Harness：桌面端运行时直接接入；未运行时使用同一份 $DSH_HOME 中已准备的配置集启动。",
  "version": "0.1.5",
  "publisher": "Elk-ydy",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0e639c",
    "theme": "dark"
  },
  "keywords": [
    "deepseek",
    "deepseek harness",
    "dsh",
    "acp",
    "agent",
    "chat",
    "ai",
    "side panel"
  ],
  "homepage": "https://github.com/elk-9527/dsh-vscode#readme",
  "bugs": {
    "url": "https://github.com/elk-9527/dsh-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elk-9527/dsh-vscode.git",
    "directory": "packages/vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "icon": "node tools/make-icon.cjs",
    "package": "npx @vscode/vsce package",
    "publish": "node tools/publish.js --yes"
  },
  "activationEvents": [
    "onView:dshPanel.chat",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "面板只与用户自己的 DSH 通信，不执行工作区中的代码：读取工作区文件仅在用户主动通过右键菜单执行「带进对话」时发生，设置项也只读取用户级设置（受限模式下 VS Code 本就不会应用工作区设置）。不声明这一条时，VS Code 会在受限模式下禁用整个扩展，表现为面板不显示且不报错。"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshPanel",
          "title": "DSH Panel",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dshPanel": [
        {
          "id": "dshPanel.chat",
          "name": "对话",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "dshPanel.open",
        "title": "DSH：打开面板",
        "category": "DSH"
      },
      {
        "command": "dshPanel.newSession",
        "title": "DSH：新建对话",
        "icon": "$(add)"
      },
      {
        "command": "dshPanel.reconnect",
        "title": "DSH：重新连接",
        "icon": "$(debug-restart)"
      },
      {
        "command": "dshPanel.showLog",
        "title": "DSH：查看日志"
      },
      {
        "command": "dshPanel.stopKernel",
        "title": "DSH：停止后台内核"
      },
      {
        "command": "dshPanel.attachFile",
        "title": "DSH：把当前文件带进对话",
        "icon": "$(file-add)"
      },
      {
        "command": "dshPanel.attachSelection",
        "title": "DSH：把选中的代码带进对话",
        "icon": "$(selection)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dshPanel.newSession",
          "when": "view == dshPanel.chat",
          "group": "navigation@1"
        },
        {
          "command": "dshPanel.reconnect",
          "when": "view == dshPanel.chat",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "dshPanel.attachSelection",
          "when": "editorHasSelection",
          "group": "dsh@1"
        },
        {
          "command": "dshPanel.attachFile",
          "group": "dsh@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dshPanel.open"
        },
        {
          "command": "dshPanel.stopKernel"
        },
        {
          "command": "dshPanel.attachSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "DSH Panel",
      "properties": {
        "dshPanel.host": {
          "type": "string",
          "enum": [
            "127.0.0.1",
            "localhost"
          ],
          "default": "127.0.0.1",
          "scope": "machine",
          "description": "DSH 的连接地址。仅支持本机回环地址，其他地址不会用于连接。"
        },
        "dshPanel.port": {
          "type": "number",
          "default": 47821,
          "scope": "machine",
          "description": "面板连接的端口。默认 47821：桌面端运行时该端口上已有 DSH 在监听，面板会直接接入并共用同一个内核，不自行启动。"
        },
        "dshPanel.selfStartPort": {
          "type": "number",
          "default": 47831,
          "scope": "machine",
          "description": "面板自行启动内核时使用的端口。默认 47831，与桌面端的 47821 有意分开：两个内核争用同一个端口时，未取得端口的一方不会建立监听，面板只会持续显示「正在启动…」。"
        },
        "dshPanel.kernelIdleMinutes": {
          "type": "number",
          "default": 10,
          "scope": "machine",
          "description": "面板自行启动的内核，在最后一个面板关闭之后保留的时长（分钟）。在此期间重新打开面板会继续使用同一个内核，无需重启，也无需重连。窗口关闭时无条件终止。设为 0 表示面板关闭即终止（旧行为）。"
        },
        "dshPanel.autoStart": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "端口上没有 DSH 在监听时，自行启动一个 DSH 内核。自启配置集与桌面端共用同一份 $DSH_HOME，但其插件、模型与设置需分别准备；停用则只连接已经在运行的内核。"
        },
        "dshPanel.fallbackProfile": {
          "type": "string",
          "default": "vscode-panel",
          "scope": "machine",
          "description": "自行启动内核时使用哪个配置集。默认 vscode-panel。不要填 desktop：该配置集由桌面端独占，命令行无法启动。该配置集必须安装连接组件，并准备所需的模型和个人插件；启动失败时，面板会在 $DSH_HOME/profiles 中另找一个已安装连接组件的网页配置集继续尝试。"
        },
        "dshPanel.dshCommand": {
          "type": "string",
          "default": "dsh",
          "scope": "machine",
          "description": "dsh 命令行程序的名字或完整路径。可以带参数 —— 例如本机 dsh 不在 PATH 上时，填「node C:\\Users\\<用户名>\\.dsh\\profiles\\node_modules\\@deepseek-ai\\dsh\\lib\\bin.js」；路径中有空格时，用双引号将整段括起来。"
        },
        "dshPanel.provider": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "新会话的初始模型服务商。留空则由内核决定。"
        },
        "dshPanel.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "新会话的初始模型名。留空则由内核决定。"
        },
        "dshPanel.preset": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "新会话挂载的 agent preset（standard 标准模式 / ptc PTC 模式 / minimal 极简模式 / cordis 创造模式）。留空则使用 DSH 侧配置的预设（默认 standard）。注意：预设只能在新建对话时选择 —— 内核不允许在一段对话中途更换，在面板中更换预设的含义是下一段新对话使用它。"
        },
        "dshPanel.cwd": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "新会话的工作目录。留空则使用 VS Code 当前打开的工作区目录。"
        }
      }
    }
  }
}
