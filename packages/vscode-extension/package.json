{
  "name": "dsh-acp-panel",
  "displayName": "DSH ACP Panel",
  "description": "在 VS Code 使用 DeepSeek Harness：对话、工具、代码审查、技能浏览和插件运行记录。",
  "version": "0.6.0",
  "publisher": "Elk-ydy",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#eaf1ff",
    "theme": "light"
  },
  "keywords": [
    "deepseek",
    "deepseek harness",
    "dsh",
    "acp",
    "agent",
    "chat",
    "ai",
    "side panel"
  ],
  "homepage": "https://github.com/elk-9527/dsh-vscode#readme",
  "bugs": {
    "url": "https://github.com/elk-9527/dsh-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elk-9527/dsh-vscode.git",
    "directory": "packages/vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "icon": "node tools/make-icon.cjs",
    "package": "npx @vscode/vsce package",
    "publish": "node tools/publish.js --yes"
  },
  "activationEvents": [
    "onView:dshPanel.chat",
    "onStartupFinished",
    "onChatParticipant:dshPanel.dsh"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "受限工作区可以使用对话面板和用户级技能浏览；代码审查和项目技能读取需要受信任的工作区。连接设置只读取用户级配置。"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshPanel",
          "title": "DSH Panel",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dshPanel": [
        {
          "id": "dshPanel.chat",
          "name": "对话",
          "type": "webview"
        },
        {
          "id": "dshPanel.capabilities",
          "name": "工具"
        },
        {
          "id": "dshPanel.operations",
          "name": "运行记录"
        }
      ]
    },
    "commands": [
      {
        "command": "dshPanel.open",
        "title": "DSH：打开面板",
        "category": "DSH"
      },
      {
        "command": "dshPanel.newSession",
        "title": "DSH：新建对话",
        "icon": "$(add)"
      },
      {
        "command": "dshPanel.reconnect",
        "title": "DSH：重新连接",
        "icon": "$(debug-restart)"
      },
      {
        "command": "dshPanel.showLog",
        "title": "DSH：查看日志"
      },
      {
        "command": "dshPanel.stopKernel",
        "title": "DSH：停止后台内核"
      },
      {
        "command": "dshPanel.setupProfile",
        "title": "DSH：准备或修复自启配置"
      },
      {
        "command": "dshPanel.attachFile",
        "title": "DSH：把当前文件带进对话",
        "icon": "$(file-add)"
      },
      {
        "command": "dshPanel.attachSelection",
        "title": "DSH：把选中的代码带进对话",
        "icon": "$(selection)"
      },
      {
        "command": "dshPanel.bridge.refresh",
        "title": "DSH：刷新插件能力",
        "icon": "$(refresh)"
      },
      {
        "command": "dshPanel.bridge.review",
        "title": "DSH：审查代码变更",
        "icon": "$(checklist)"
      },
      {
        "command": "dshPanel.bridge.skills",
        "title": "DSH：搜索技能",
        "icon": "$(search)"
      },
      {
        "command": "dshPanel.bridge.readSkill",
        "title": "DSH：读取技能"
      },
      {
        "command": "dshPanel.bridge.openReport",
        "title": "DSH：打开报告"
      },
      {
        "command": "dshPanel.bridge.attachReview",
        "title": "DSH：将审查结果带入对话",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dshPanel.bridge.cancel",
        "title": "DSH：取消运行",
        "icon": "$(stop-circle)"
      },
      {
        "command": "dshPanel.bridge.diagnose",
        "title": "DSH：检查技能状态",
        "icon": "$(pulse)"
      },
      {
        "command": "dshPanel.bridge.diagnoseConfig",
        "title": "DSH：诊断连接与配置",
        "icon": "$(inspect)"
      },
      {
        "command": "dshPanel.bridge.copyDiagnostics",
        "title": "DSH：复制连接与配置诊断",
        "icon": "$(copy)"
      },
      {
        "command": "dshPanel.bridge.installGuide",
        "title": "DSH：查看插件安装说明",
        "icon": "$(extensions)"
      },
      {
        "command": "dshPanel.bridge.reloadOwned",
        "title": "DSH：重新加载面板后台内核",
        "icon": "$(debug-restart)"
      },
      {
        "command": "dshPanel.bridge.retry",
        "title": "DSH：重新运行审查",
        "icon": "$(debug-restart)"
      },
      {
        "command": "dshPanel.bridge.remove",
        "title": "DSH：移除已结束记录",
        "icon": "$(trash)"
      },
      {
        "command": "dshPanel.bridge.clearFinished",
        "title": "DSH：清理已结束记录",
        "icon": "$(clear-all)"
      },
      {
        "command": "dshPanel.bridge.manageSkills",
        "title": "DSH：管理技能",
        "icon": "$(edit)"
      },
      {
        "command": "dshPanel.bridge.applySkillDraft",
        "title": "DSH：预览并应用技能修改",
        "icon": "$(diff)"
      },
      {
        "command": "dshPanel.chat.openSession",
        "title": "DSH：在面板继续 Chat 会话"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dshPanel.bridge.diagnoseConfig",
          "when": "view == dshPanel.capabilities",
          "group": "navigation@3"
        },
        {
          "command": "dshPanel.bridge.installGuide",
          "when": "view == dshPanel.capabilities",
          "group": "actions@1"
        },
        {
          "command": "dshPanel.bridge.clearFinished",
          "when": "view == dshPanel.operations",
          "group": "navigation"
        },
        {
          "command": "dshPanel.newSession",
          "when": "view == dshPanel.chat",
          "group": "navigation@1"
        },
        {
          "command": "dshPanel.reconnect",
          "when": "view == dshPanel.chat",
          "group": "navigation@2"
        },
        {
          "command": "dshPanel.bridge.refresh",
          "when": "view == dshPanel.capabilities",
          "group": "navigation"
        },
        {
          "command": "dshPanel.bridge.skills",
          "when": "view == dshPanel.capabilities",
          "group": "navigation"
        },
        {
          "command": "dshPanel.bridge.manageSkills",
          "when": "view == dshPanel.capabilities",
          "group": "actions@2"
        }
      ],
      "editor/context": [
        {
          "command": "dshPanel.attachSelection",
          "when": "editorHasSelection",
          "group": "dsh@1"
        },
        {
          "command": "dshPanel.attachFile",
          "group": "dsh@2"
        },
        {
          "command": "dshPanel.bridge.review",
          "when": "resourceScheme == file && isWorkspaceTrusted",
          "group": "dsh"
        }
      ],
      "commandPalette": [
        {
          "command": "dshPanel.open"
        },
        {
          "command": "dshPanel.stopKernel"
        },
        {
          "command": "dshPanel.setupProfile"
        },
        {
          "command": "dshPanel.attachSelection",
          "when": "editorHasSelection"
        }
      ],
      "scm/title": [
        {
          "command": "dshPanel.bridge.review",
          "when": "scmProvider == git && isWorkspaceTrusted",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dshPanel.bridge.attachReview",
          "when": "view == dshPanel.operations && viewItem == dshCompletedReview && isWorkspaceTrusted",
          "group": "inline@0"
        },
        {
          "command": "dshPanel.bridge.retry",
          "when": "view == dshPanel.operations && (viewItem == dshFinishedOperation || viewItem == dshCompletedReview) && isWorkspaceTrusted",
          "group": "inline@1"
        },
        {
          "command": "dshPanel.bridge.remove",
          "when": "view == dshPanel.operations && (viewItem == dshFinishedOperation || viewItem == dshCompletedReview)",
          "group": "inline@2"
        },
        {
          "command": "dshPanel.bridge.cancel",
          "when": "view == dshPanel.operations && viewItem == dshRunningOperation",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "DSH Panel",
      "properties": {
        "dshPanel.host": {
          "type": "string",
          "enum": [
            "127.0.0.1",
            "localhost"
          ],
          "default": "127.0.0.1",
          "scope": "machine",
          "description": "DSH 的连接地址。仅支持本机回环地址，其他地址不会用于连接。"
        },
        "dshPanel.port": {
          "type": "number",
          "default": 47821,
          "scope": "machine",
          "description": "面板连接的端口。默认 47821：桌面端运行时该端口上已有 DSH 在监听，面板会直接接入并共用同一个内核，不自行启动。"
        },
        "dshPanel.selfStartPort": {
          "type": "number",
          "default": 47831,
          "scope": "machine",
          "description": "面板自行启动内核时使用的端口。默认 47831，与桌面端的 47821 有意分开：两个内核争用同一个端口时，未取得端口的一方不会建立监听，面板只会持续显示「正在启动…」。"
        },
        "dshPanel.kernelIdleMinutes": {
          "type": "number",
          "default": 10,
          "scope": "machine",
          "description": "面板自行启动的内核，在最后一个使用方退出后保留的时长（分钟）。窗口关闭时，正在进行的插件任务继续完成，空闲后回收。设为 0 表示空闲即回收。"
        },
        "dshPanel.autoStart": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "端口上没有 DSH 在监听时，自行启动一个 DSH 内核。自启配置集与桌面端共用同一份 $DSH_HOME，但其插件、模型与设置需分别准备；停用则只连接已经在运行的内核。"
        },
        "dshPanel.fallbackProfile": {
          "type": "string",
          "default": "vscode-panel",
          "scope": "machine",
          "description": "自行启动内核时使用哪个配置集。默认 vscode-panel。不要填 desktop：该配置集由桌面端独占，命令行无法启动。默认配置集会同步桌面端已启用的注册表插件和运行时 bundle，并只读加载 desktop 的模型路由、插件开关与参数；本地路径或 Git 来源不会自动复制。启动失败时，面板会在 $DSH_HOME/profiles 中另找一个已安装连接组件的网页配置集继续尝试。"
        },
        "dshPanel.dshCommand": {
          "type": "string",
          "default": "dsh",
          "scope": "machine",
          "description": "DSH 命令行的覆盖项。通常保持默认即可：面板会自动查找 PATH、旧版用户目录和 DSH Desktop 0.2 随附的运行时。需要手动指定时可填写程序名、完整路径或带参数的完整命令；路径中有空格时用双引号括起。"
        },
        "dshPanel.provider": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "新会话的初始模型服务商。留空则由内核决定。"
        },
        "dshPanel.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "新会话的初始模型名。留空则由内核决定。"
        },
        "dshPanel.preset": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "新会话挂载的 agent preset（standard 标准模式 / ptc PTC 模式 / minimal 极简模式 / cordis 创造模式）。留空则使用 DSH 侧配置的预设（默认 standard）。注意：预设只能在新建对话时选择 —— 内核不允许在一段对话中途更换，在面板中更换预设的含义是下一段新对话使用它。"
        },
        "dshPanel.cwd": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "新会话的工作目录。留空则使用 VS Code 当前打开的工作区目录。"
        }
      }
    },
    "chatParticipants": [
      {
        "id": "dshPanel.dsh",
        "name": "dsh",
        "fullName": "DeepSeek Harness",
        "description": "使用 DSH 对话、审查代码和浏览技能",
        "commands": [
          {
            "name": "new",
            "description": "开始新的 DSH 对话"
          },
          {
            "name": "review",
            "description": "审查当前代码变更"
          },
          {
            "name": "skills",
            "description": "浏览可用技能"
          },
          {
            "name": "open-panel",
            "description": "在 DSH 面板继续当前会话"
          }
        ]
      }
    ]
  },
  "types": "./src/api/index.d.ts"
}
