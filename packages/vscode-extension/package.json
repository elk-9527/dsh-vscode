{
  "name": "dsh-panel",
  "displayName": "DSH Panel",
  "description": "在 VS Code 侧边栏里使用你正在运行的 DeepSeek Harness（同一个内核、同一份记忆、同一份会话记录）。",
  "version": "0.0.1",
  "private": true,
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:dshPanel.chat",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "面板只跟你自己的 DSH 说话，不会执行工作区里的代码：它读工作区文件只在你主动右键「带进对话」时发生，设置项也只读用户级设置（受限模式下 VS Code 本来就不会套用工作区设置）。不声明这一条的话，VS Code 在受限模式里会把这个扩展整个禁掉 —— 表现是「面板凭空消失、还不报错」，这一夜真踩过。"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshPanel",
          "title": "DSH Panel",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dshPanel": [
        {
          "id": "dshPanel.chat",
          "name": "对话",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "dshPanel.open",
        "title": "DSH：打开面板",
        "category": "DSH"
      },
      {
        "command": "dshPanel.newSession",
        "title": "DSH：新建对话",
        "icon": "$(add)"
      },
      {
        "command": "dshPanel.reconnect",
        "title": "DSH：重新连接",
        "icon": "$(debug-restart)"
      },
      {
        "command": "dshPanel.showLog",
        "title": "DSH：查看日志"
      },
      {
        "command": "dshPanel.attachFile",
        "title": "DSH：把当前文件带进对话",
        "icon": "$(file-add)"
      },
      {
        "command": "dshPanel.attachSelection",
        "title": "DSH：把选中的代码带进对话",
        "icon": "$(selection)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dshPanel.newSession",
          "when": "view == dshPanel.chat",
          "group": "navigation@1"
        },
        {
          "command": "dshPanel.reconnect",
          "when": "view == dshPanel.chat",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "dshPanel.attachSelection",
          "when": "editorHasSelection",
          "group": "dsh@1"
        },
        {
          "command": "dshPanel.attachFile",
          "group": "dsh@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dshPanel.open"
        },
        {
          "command": "dshPanel.attachSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "DSH Panel",
      "properties": {
        "dshPanel.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "DSH「门」的监听地址。默认只连本机。"
        },
        "dshPanel.port": {
          "type": "number",
          "default": 47821,
          "description": "DSH「门」的端口。与门插件 cordis.patch.yml 里的 port 保持一致。"
        },
        "dshPanel.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "连不上时，自动在后台拉起一个 DSH（与桌面端共用同一份 $DSH_HOME，因此记忆与会话记录是同一份）。关掉则只连已经在跑的。"
        },
        "dshPanel.fallbackProfile": {
          "type": "string",
          "default": "desktop",
          "description": "自动拉起后台 DSH 时使用的 profile 名。默认 desktop —— 就是你桌面端那一档，记忆、技能、插件完全一致，只是没有窗口。这个 profile 里必须装好 dsh-acp-door 门插件。"
        },
        "dshPanel.dshCommand": {
          "type": "string",
          "default": "dsh",
          "description": "dsh 命令行程序的名字或完整路径。"
        },
        "dshPanel.provider": {
          "type": "string",
          "default": "",
          "description": "新会话的初始模型服务商。留空则由内核决定。"
        },
        "dshPanel.model": {
          "type": "string",
          "default": "",
          "description": "新会话的初始模型名。留空则由内核决定。"
        },
        "dshPanel.preset": {
          "type": "string",
          "default": "",
          "description": "新会话挂载的 agent preset（standard 标准模式 / ptc PTC 模式 / minimal 极简模式 / cordis 创造模式）。留空则用门插件里配的那个（默认 standard）。注意：预设只能在新建对话时选 —— 内核不允许一段对话中途换，面板里换预设的语义就是「下一段新对话用它」。"
        },
        "dshPanel.cwd": {
          "type": "string",
          "default": "",
          "description": "新会话的工作目录。留空则用 VS Code 当前打开的工作区目录。"
        }
      }
    }
  }
}
