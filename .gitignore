node_modules/
dist/
out/
*.vsix

# M0 原始抓包可能包含文件内容，不入库；筛选后的帧另行放进 packages/acp/test/fixtures
spike/capture/
spike/scratch/

.DS_Store
*.log

# 打包产物（可随时用 npm pack 重新生成）
*.tgz

# 扩展的构建与测试产物：vsix、界面预览页、无头浏览器临时配置
packages/vscode-extension/build*/

# 界面截图（tools/shots.js 生成，改界面前后对比用）。不放 build/ 里：
# build-vsix 会把整个 build/ 清掉，图会跟着没。
packages/vscode-extension/shots/

# 改用户档之前的备份（体积大，且是机器专属的，不入库）
backup/

# 试验台用的临时配置（每次现写现删）
spike/door-*.yml

# WorkBuddy 的项目记忆（agent 工作数据，本机专属，不入库）
.workbuddy/

# 会话勘察报告（含用户会话标题等个人信息，不入库；工具本身在 spike/session-survey.cjs）
spike/session-survey-report.txt

